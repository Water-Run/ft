root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

# 取证材料逐字节保存；不由编辑器统一换行或尾空格。
[videos/**/research/lab/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
