  "quotes": [
    {
      "doc": "gray81",
      "what": "title and date",
      "quote": "Tandem TR 81.3 The Transaction Concept: Virtues and Limitations Jim Gray Tandem Computers Incorporated"
    },
    {
      "doc": "gray81",
      "what": "June 1981",
      "quote": "Cupertino CA 95014 June 1981"
    },
    {
      "doc": "gray81",
      "what": "three properties",
      "quote": "A transaction is a transformation of state which has the properties of atomicity (all or nothing), durability (effects survive failures) and consistency (a correct transformation)."
    },
    {
      "doc": "turing_gray",
      "what": "IBM San Jose 1972-1980",
      "quote": "Research Staff Member, Computer Science Department, IBM Research, San Jose, CA (1972–1980)"
    },
    {
      "doc": "turing_gray",
      "what": "Tandem 1980-1990",
      "quote": "Software Designer, Tandem Computers, Cupertino, CA (1980–1990)"
    },
    {
      "doc": "turing_gray",
      "what": "System R",
      "quote": "Gray soon joined this project, which became known as System R."
    },
    {
      "doc": "turing_gray",
      "what": "transaction as unit of work",
      "quote": "He defined the transaction as a unit of work, such as moving money from one bank account to another, that must leave the bank’s database in a consistent state whether or not the transaction succeeds: either the money moves, or it stays in the original account."
    },
    {
      "doc": "turing_gray",
      "what": "1998 citation",
      "quote": "1998 CITATION For seminal contributions to database and transaction processing research and technical leadership in system implementation."
    },
    {
      "doc": "hr83",
      "what": "authors",
      "quote": "THEO HAERDER Fachbereich Informatik, University of Kaiserslautern, West Germany ANDREAS REUTER 1 IBM Research Laboratory, San Jose, California"
    },
    {
      "doc": "hr83",
      "what": "journal",
      "quote": "Computing Surveys, Vol. 15, No. 4, December 1983"
    },
    {
      "doc": "hr83",
      "what": "ACID",
      "quote": "These four properties, atomicity, consist- ency, isolation, and durability (ACID), de- scribe the major highlights of the transac- tion paradigm"
    },
    {
      "doc": "aries",
      "what": "title",
      "quote": "ARIES: A Transaction Recovery Method Supporting Fine-Granularity Locking and Partial Rollbacks Using Write-Ahead Logging C. MOHAN IBM Almaden Research Center"
    },
    {
      "doc": "aries",
      "what": "WAL",
      "quote": "recovery using write-ahead logging (WAL)"
    },
    {
      "doc": "aries",
      "what": "repeating history",
      "quote": "We introduce the paradigm of repeating history to redo all missing updates before performing the rollbacks of the loser transactions during restart after a system failure."
    },
    {
      "doc": "aries",
      "what": "journal",
      "quote": "ACM Transactions on Database Systems, Vol. 17, No. 1, March 1992"
    },
    {
      "doc": "bg83",
      "what": "date",
      "quote": "ACM Transactions on Database Systems Volume 8 Issue 4 Dec. 1983"
    },
    {
      "doc": "bg83",
      "what": "theory",
      "quote": "This paper presents a theory for analyzing the correctness of concurrency control algorithms for multiversion database systems."
    },
    {
      "doc": "pg_history",
      "what": "1986",
      "quote": "The implementation of POSTGRES began in 1986."
    },
    {
      "doc": "pg_history",
      "what": "Stonebraker",
      "quote": "The POSTGRES project, led by Professor Michael Stonebraker"
    },
