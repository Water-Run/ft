  },
  {
   "program": "pg_ctl",
   "args": [
    "-D",
    "<work>\\cluster",
    "-l",
    "<work>\\server.log",
    "-w",
    "start"
   ],
   "exit": 0,
   "output": "waiting for server to start.... done\nserver started\n"
  },
  {
