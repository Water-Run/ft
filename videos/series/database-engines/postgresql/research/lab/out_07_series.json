  "scope": "跨集接续的实际脚本、同一业务数据与原始文件；不作跨版本性能比较",
  "captures": [
    {
      "movie": "myisam",
      "file": "src/js/script.js",
      "sha256": "6fb6219c0b4ac38f6932953b6b9e0fb68a6366c08c44063e181c1d8d7c624baf",
      "cues": [
        {
          "id": "b5",
          "text": "*.MYD* 文件存放数据，也就是每一行的内容"
        },
        {
          "id": "b6",
          "text": "*.MYI* 文件存放索引"
        },
        {
          "id": "f13",
          "text": "主键和普通索引的结构完全相同"
        },
        {
          "id": "f14",
          "text": "存的都是行的位置，而不是行本身"
        },
        {
          "id": "n3",
          "text": "数据怎么放：一个数据文件，一行接一行"
        },
        {
          "id": "n4",
          "text": "怎么找：B 树索引，加上行的位置"
        },
        {
          "id": "n5",
          "text": "怎么并发：一把表锁"
        },
        {
          "id": "n6",
          "text": "出错怎么办：检查，然后修复"
        }
      ]
    },
    {
      "movie": "innodb",
      "file": "src/js/script.js",
      "sha256": "6cd761eed79088de523bf0ac614c3da9cc012e9ac51f5571727d0159351573f9",
      "cues": [
        {
          "id": "k2",
          "text": "没有事务：InnoDB 用 undo 实现回滚，用读视图实现隔离"
        },
        {
          "id": "k4",
          "text": "没有日志：InnoDB 用 redo 补上没写完的修改"
        },
        {
          "id": "k4b",
          "text": "用 undo 撤销没提交的"
        },
        {
          "id": "k9",
          "text": "下一集换一个引擎，看同一组问题，有怎样不同的实现"
        }
      ]
    }
  ],
