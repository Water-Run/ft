# 依赖（npm ci 得到）
node_modules/

# 本机的二进制依赖：字体、ffmpeg、语音识别模型。字体与模型用 node kit/tools/assets.js --fetch 取得
/assets/*
!/assets/README.md

# 本机配置（Chrome、ffmpeg、Python 的位置等）
/kit/config.local.json

# 本机密钥与不入库的制作备忘
/kit/local/

# 制作锁与独立练习目录；不承载正式制作记录
.ft-work.lock
.venv/
.env
.env.*
!.env.example

# 仓库根的 out/：本机临时产物、盘点脚本与工具输出，不入库
/out/

# 各视频的生成物：配音缓存、成片与中间文件、截图、工具的中间数据
/videos/**/audio/
/videos/**/out/
/videos/**/shots/
/videos/**/build/

# 取证用到的第三方源码与安装包：只在 FACTS.md 里记版本与获取方式
/videos/**/research/_src/

# 杂项
__pycache__/
*.pyc
*.part
.DS_Store
Thumbs.db
desktop.ini
